// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =====================================================================
// AUTENTIKASI (better-auth)
// =====================================================================

model User {
  id               String      @id
  name             String
  email            String      @unique
  emailVerified    Boolean     @default(false)
  image            String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  
  sessions         Session[]
  accounts         Account[]
  twoFactorEnabled Boolean?    @default(false)
  twofactors       TwoFactor[]

  // ======= Ekstensi untuk Portal Prestasi Universitas =======
  mahasiswa        Mahasiswa?
  userRoles        UserRole[]
  
  // Relasi Validasi (Admin/WD/Akreditasi yang memvalidasi)
  validasiPrestasi Prestasi[]  @relation("ValidatorPrestasi")
  notifications    Notification[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id          String   @id
  secret      String
  backupCodes String
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified    Boolean? @default(true)

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

// =====================================================================
// MANAJEMEN ROLE
// =====================================================================

model Role {
  id          String     @id @default(cuid())
  name        String     @unique // "MAHASISWA", "ADMIN", "AKREDITASI", "WD"
  description String?
  
  userRoles   UserRole[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("role")
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, roleId])
  @@map("user_role")
}


// =====================================================================
// DATA MASTER & PROFIL PENGGUNA
// =====================================================================

model Mahasiswa {
  id             String        @id @default(cuid())
  userId         String        @unique
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  nim            String        @unique
  tempatLahir    String?
  tanggalLahir   DateTime?
  jenisKelamin   JenisKelamin?
  agama          String?
  alamat         String?       @db.Text
  noHp           String?
  
  programStudiId String?
  programStudi   ProgramStudi? @relation(fields: [programStudiId], references: [id])

  prestasi       Prestasi[]

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("mahasiswa")
}

enum JenisKelamin {
  LAKI_LAKI
  PEREMPUAN
}

model ProgramStudi {
  id          String      @id @default(cuid())
  nama        String      @unique // Contoh: "S1 Teknik Informatika", "S1 Sistem Informasi"
  mahasiswa   Mahasiswa[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("program_studi")
}

model KategoriPrestasi {
  id         String     @id @default(cuid())
  nama       String     @unique // Contoh: "Akademik", "Seni", "Olahraga", dll
  keterangan String?
  prestasi   Prestasi[]

  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@map("kategori_prestasi")
}

model TingkatPrestasi {
  id         String     @id @default(cuid())
  nama       String     @unique // Contoh: "Universitas", "Kabupaten", "Provinsi", "Nasional", "Internasional"
  bobotPoin  Int        @default(0) // Default poin untuk tingkat ini
  prestasi   Prestasi[]

  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@map("tingkat_prestasi")
}


// =====================================================================
// TRANSAKSI UTAMA: PRESTASI
// =====================================================================

model Prestasi {
  id                 String           @id @default(cuid())
  
  // Relasi Mahasiswa
  mahasiswaId        String
  mahasiswa          Mahasiswa        @relation(fields: [mahasiswaId], references: [id], onDelete: Cascade)
  
  // Relasi Kategori & Tingkat
  kategoriId         String
  kategori           KategoriPrestasi @relation(fields: [kategoriId], references: [id])
  
  tingkatId          String
  tingkat            TingkatPrestasi  @relation(fields: [tingkatId], references: [id])

  // Waktu Kegiatan
  angkatan           Int              // Angkatan mahasiswa saat kegiatan
  tahun              Int              // Tahun pelaksanaan kegiatan
  semester           Semester         @default(GANJIL)

  // Detail Prestasi
  namaPrestasi       String           // Contoh: "Juara 1 Lomba Cerdas Cermat"
  jenisLomba         JenisLomba       @default(MANDIRI)
  namaPenyelenggara  String           // Contoh: "Kementerian Pendidikan"
  tanggalMulai       DateTime
  tanggalSelesai     DateTime
  hasilCapaian       String           // Contoh: "Juara 1", "Juara 2", atau capaian lainnya (max 250)

  // Tempat Pelaksanaan
  provinsi           String?
  kota               String?
  namaLokasi         String?          // Nama gedung/tempat spesifik

  // Tipe Partisipasi
  tipePartisipasi    TipePartisipasi  @default(INDIVIDU)
  anggotaTim         Json?            // Array of { nim: string, nama: string } jika TIM

  // Berkas Bukti
  sertifikatUrls     Json?            // Array URL sertifikat (max 10 file) di R2
  buktiBuktiUrls     Json?            // Array URL bukti pendukung (max 10 file) di R2
  keterangan         String?          @db.Text

  // Poin akhir yang dihitung/disetujui
  poin               Int              @default(0) 

  // Workflow Validasi
  statusValidasi     StatusValidasi   @default(PENDING)
  validatorId        String?
  validator          User?            @relation("ValidatorPrestasi", fields: [validatorId], references: [id])
  catatanValidasi    String?          @db.Text
  tanggalValidasi    DateTime?

  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@map("prestasi")
}

enum StatusValidasi {
  PENDING
  APPROVED
  REJECTED
}

enum Semester {
  GANJIL
  GENAP
}

enum TipePartisipasi {
  INDIVIDU
  TIM
}

enum JenisLomba {
  BELMAWA
  MANDIRI
}

// =====================================================================
// DATA AKREDITASI (LAM TEKNIK)
// =====================================================================

model NmTs {
  id              String   @id @default(cuid())
  tahun           Int      @unique // Contoh: 2024, 2025, 2026
  jumlahMahasiswa Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("nmts")
}

model TargetAkreditasi {
  id          String   @id @default(cuid())
  kodeTarget  String   @unique // Contoh: "RI", "RN", "RW"
  nama        String   // Contoh: "Target Rasio Internasional"
  nilaiPersen Float    // Contoh: 0.2, 2.0, 4.0
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("target_akreditasi")
}

// =====================================================================
// NOTIFIKASI
// =====================================================================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title     String
  message   String   @db.Text
  type      String   // INFO, SUCCESS, WARNING, ERROR
  isRead    Boolean  @default(false)
  linkUrl   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("notification")
}

